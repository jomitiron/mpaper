# Defaults for `pnpm --filter web dev`. No secrets. Override in .env.development.local.
# Mocks are on, so every flag is on too: the mocks serve the missing endpoints.
VITE_API_BASE_URL=https://ijanla-dev.azurewebsites.net
VITE_APP_URL=http://localhost:5170
VITE_SITE_URL=http://localhost:4320
VITE_USE_MOCKS=true
VITE_FLAG_RENEWALS=true
VITE_FLAG_REMINDER_SETTINGS=true
VITE_FLAG_TX_LABELS=true
VITE_FLAG_WALLET_PAY=true
VITE_FLAG_VERIFY_PAYMENT=true
