# Copy to .env.development.local (git-ignored) to override the defaults in .env.development.
# Deploys set these per environment in GitHub (see docs/setup.md). Nothing here is secret.

# MotorPapers API: ijanla-dev (preview), ijanla-stage (staging), ijanla (production)
VITE_API_BASE_URL=https://ijanla-dev.azurewebsites.net

# Document reader that reads licence photos (no token)
VITE_DOC_PARSER_URL=https://motorpapers-doc-parser-api.azurewebsites.net/api/vehicleDocument

# Links between the app and the marketing site
VITE_APP_URL=http://localhost:5170
VITE_SITE_URL=http://localhost:4320

# Serve every API call from the mocks in packages/api (true/false)
VITE_USE_MOCKS=true

# Error reporting (phase 6)
VITE_SENTRY_DSN=

# Features that need endpoints the backend hasn't built yet (docs/phases/api-gaps.md).
# Turn them on with mocks, or once the backend ships them.
VITE_FLAG_RENEWALS=false
VITE_FLAG_REMINDER_SETTINGS=false
VITE_FLAG_TX_LABELS=false
VITE_FLAG_WALLET_PAY=false
VITE_FLAG_VERIFY_PAYMENT=false
