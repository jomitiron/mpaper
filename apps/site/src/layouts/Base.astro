---
import '../styles/site.css';
import gabaritoLatin from '../fonts/gabarito-latin.woff2?url';
import figtreeLatin from '../fonts/figtree-latin.woff2?url';
import IconSprite from '../components/IconSprite.astro';
import { ANALYTICS_DOMAIN, DEFAULT_DESCRIPTION, NOINDEX } from '../config';

interface Props {
  title: string;
  description?: string;
  /** Structured data for this page, rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>;
  /** Keep this page out of search results (the 404 page, placeholder legal pages). */
  noindex?: boolean;
}

const { title, description = DEFAULT_DESCRIPTION, jsonLd, noindex = false } = Astro.props;
const indexable = !noindex && !NOINDEX;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const ogImageAlt =
  'MotoPapers: never drive with expired papers again. Cards showing the days left on a car’s licence, insurance and roadworthiness.';
---

<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      indexable ? (
        <link rel="canonical" href={canonical} />
      ) : (
        <meta name="robots" content="noindex" />
      )
    }
    <meta name="theme-color" content="#f4f3f9" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={gabaritoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={figtreeLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MotoPapers" />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
        />
      )
    }
    {
      ANALYTICS_DOMAIN && (
        <script
          is:inline
          defer
          data-domain={ANALYTICS_DOMAIN}
          src="https://plausible.io/js/script.js"
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <IconSprite />
    <slot />
  </body>
</html>
