---
import Base from './Base.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
import { LEGAL_IS_PLACEHOLDER, appLink } from '../config';

interface Props {
  title: string;
  description: string;
  /** e.g. "Last updated: 1 Nov 2026". */
  updated?: string;
}

const { title, description, updated } = Astro.props;
---

<Base title={`${title} · MotoPapers`} description={description} noindex={LEGAL_IS_PLACEHOLDER}>
  <div class="legal-shell">
    <header class="legal-nav">
      <Logo href="/" />
      <div class="acts">
        <a class="btn btn-white" href={appLink('/sign-in')}>Sign in</a>
        <a class="btn btn-coral" href={appLink('/sign-up')}>Get started</a>
      </div>
    </header>
  </div>

  <main class="legal" id="content">
    <h1>{title}</h1>
    {updated && <p class="updated">{updated}</p>}
    {
      LEGAL_IS_PLACEHOLDER && (
        <div class="placeholder-note" role="note">
          <strong>Placeholder text.</strong> This page is a draft outline for the owner of
          MotoPapers to replace before launch. It is not legal advice and is not in force. Every
          part marked “To be written” needs the owner’s wording.
        </div>
      )
    }
    <slot />
  </main>

  <Footer />
</Base>

<style>
  .legal-shell {
    max-width: 1320px;
    margin: 0 auto;
    padding: 14px 14px 0;
  }
  .legal-nav {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 28px;
  }
  .acts {
    display: flex;
    gap: 8px;
    margin-left: auto;
  }
  .legal {
    max-width: 820px;
    margin: 24px auto 0;
    padding: 40px 48px 48px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 30px;
    display: grid;
    gap: 16px;
    color: var(--ink-2);
    font-size: 15.5px;
  }
  h1 {
    font-weight: 900;
    font-size: clamp(34px, 5vw, 54px);
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--ink);
  }
  .updated {
    color: var(--muted);
    font-size: 14px;
  }
  .placeholder-note {
    padding: 14px 16px;
    border-radius: 16px;
    background: var(--due);
    color: var(--ink);
    font-size: 14.5px;
  }
  .legal :global(h2) {
    font-weight: 800;
    font-size: 22px;
    color: var(--ink);
    margin-top: 16px;
  }
  .legal :global(ul) {
    display: grid;
    gap: 6px;
    padding-left: 20px;
    list-style: disc;
  }
  .legal :global(a) {
    color: var(--ink);
    font-weight: 700;
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
  }
  .legal :global(.todo) {
    display: inline-block;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.02em;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--due);
    color: var(--due-i);
    vertical-align: middle;
  }
  @media (max-width: 820px) {
    .legal-nav {
      padding: 14px 16px;
    }
  }
  @media (max-width: 560px) {
    .legal-shell {
      padding: 8px 8px 0;
    }
    .acts .btn-white {
      display: none;
    }
    .legal {
      margin: 16px 8px 0;
      padding: 28px 20px 32px;
      border-radius: 24px;
    }
  }
</style>
