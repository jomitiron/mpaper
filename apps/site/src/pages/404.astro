---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
---

<Base title="Page not found · MotoPapers" description="We couldn't find that page." noindex>
  <main class="nf" id="content">
    <Logo href="/" />
    <h1>Page not found</h1>
    <p>We couldn't find that page. Check the address, or go back to the home page.</p>
    <a class="btn btn-coral btn-lg" href="/">Go to the home page</a>
  </main>
  <Footer />
</Base>

<style>
  .nf {
    min-height: 70vh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 16px;
    padding: 48px 16px;
    text-align: center;
  }
  h1 {
    font-weight: 900;
    font-size: 40px;
    letter-spacing: -0.035em;
  }
  p {
    color: var(--ink-2);
  }
</style>
