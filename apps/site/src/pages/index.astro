---
import Base from '../layouts/Base.astro';
import { appLink } from '../config';

// Placeholder from phase 0. Phase 5 builds the landing page from the design.
---

<Base
  title="MotoPapers: never drive with expired papers again"
  description="MotoPapers keeps your vehicle licence, insurance and roadworthiness in one place, reminds you weeks before each one runs out, and renews them for you."
>
  <main class="placeholder">
    <span class="logo">
      <i aria-hidden="true">
        <svg class="ic" viewBox="0 0 24 24"
          ><path d="M7 3.5h7l4 4v13H7z"></path><path d="M14 3.5v4h4M10 12h5M10 15.5h3"></path></svg
        >
      </i>MotoPapers
    </span>
    <span class="tag">Coming in phase 5</span>
    <h1>Never drive with <span class="hl">expired papers</span> again.</h1>
    <p class="lede">
      MotoPapers keeps your vehicle licence, insurance and roadworthiness in one place, reminds you
      weeks before each one runs out, and renews them for you.
    </p>
    <div class="cta-row">
      <a class="btn btn-coral btn-lg" href={appLink('/sign-up')}>Get started</a>
      <a class="btn btn-white btn-lg" href={appLink('/sign-in')}>Sign in</a>
    </div>
  </main>
</Base>

<style>
  .placeholder {
    max-width: 900px;
    min-height: 100vh;
    margin: 0 auto;
    padding: 48px 16px;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 20px;
    text-align: center;
  }
  h1 {
    font-weight: 900;
    font-size: clamp(42px, 7.2vw, 88px);
    line-height: 0.96;
    letter-spacing: -0.045em;
  }
  .hl {
    color: var(--coral);
  }
  .lede {
    font-size: clamp(16px, 1.6vw, 19px);
    color: var(--ink-2);
    max-width: 38em;
  }
  .cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
