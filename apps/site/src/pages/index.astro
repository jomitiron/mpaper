---
import '../styles/landing.css';
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/landing/Hero.astro';
import Reminders from '../components/landing/Reminders.astro';
import HowItWorks from '../components/landing/HowItWorks.astro';
import Papers from '../components/landing/Papers.astro';
import Why from '../components/landing/Why.astro';
import Faq from '../components/landing/Faq.astro';
import FinalCta from '../components/landing/FinalCta.astro';
import { COMPANY, DEFAULT_DESCRIPTION } from '../config';

const site = Astro.site ?? Astro.url;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: COMPANY.name,
  url: new URL('/', site).href,
  logo: new URL('/logo.png', site).href,
  description: DEFAULT_DESCRIPTION,
  telephone: COMPANY.phone.tel,
  address: {
    '@type': 'PostalAddress',
    streetAddress: COMPANY.address.street,
    addressLocality: COMPANY.address.locality,
    addressRegion: COMPANY.address.region,
    addressCountry: COMPANY.address.country,
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: COMPANY.phone.tel,
    contactType: 'customer service',
    areaServed: 'NG',
    availableLanguage: 'en',
  },
};
---

<Base title="MotoPapers: never drive with expired papers again" jsonLd={organization}>
  <main>
    <Hero />
    <Reminders />
    <HowItWorks />
    <Papers />
    <Why />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Base>
