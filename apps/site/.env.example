# Copy to .env (git-ignored). Deploys set these per environment (docs/setup.md). Nothing here is secret.
PUBLIC_APP_URL=http://localhost:5170
PUBLIC_SITE_URL=http://localhost:4320
# Plausible analytics. Leave empty to turn analytics off.
PUBLIC_ANALYTICS_DOMAIN=
# true on staging and previews: adds noindex and a robots.txt that blocks crawlers.
PUBLIC_NOINDEX=
